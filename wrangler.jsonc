{
	"$schema": "node_modules/wrangler/config-schema.json",
	// PlainShare: generic video sharing worker. This copy is the PlainLab
	// deployment — other accounts start from wrangler.jsonc.example.
	// See README.md for provisioning.
	"name": "plainshare",
	// src/server.ts wraps TanStack Start's fetch handler and adds the
	// scheduled() retention job (see src/lib/retention.server.ts).
	"main": "src/server.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Daily retention: sweep expired videos, purge tombstones past the grace.
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"vars": {
		// Days an unpublished video stays restorable before it is purged.
		"PURGE_GRACE_DAYS": "30"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "share-db",
			"migrations_dir": "migrations",
			"database_id": "0cb10998-f6f7-4a5e-8d90-58a484d82a35"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "share-media"
		}
	]
}